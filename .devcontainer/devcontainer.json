{
  "name": "Portal Notas demo",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install --user -r requirements-dev.txt",
  "postAttachCommand": { "server": "uvicorn app.main:app --host 0.0.0.0 --port 8000" },
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "Demo", "onAutoForward": "openPreview" } },
  "customizations": { "vscode": { "extensions": ["ms-python.python"] } }
}
